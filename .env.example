# Supabase project (Dashboard → Project Settings → API)
# For local dev, `npx supabase start` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key for the transcription pipeline (server-side only)
ANTHROPIC_API_KEY=sk-ant-...

# Pipeline experiment knobs (optional)
# TRANSCRIBER=claude
# TRANSCRIBER_MODEL=claude-opus-5
